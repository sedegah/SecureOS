<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Surge-Setup</AssemblyName>
    <RootNamespace>SurgeInstaller</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Product>Surge Setup</Product>
    <AssemblyTitle>Surge Installer</AssemblyTitle>
    <Company>Surge</Company>
    <ApplicationIcon>..\desktop\assets\icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\build\app.zip" LogicalName="app.zip" />
    <EmbeddedResource Include="..\desktop\assets\splash.jpg" LogicalName="splash.jpg" />
    <EmbeddedResource Include="..\desktop\assets\icon.ico" LogicalName="icon.ico" />
  </ItemGroup>

</Project>

